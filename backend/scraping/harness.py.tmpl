"""Wrapper the generated run() is pasted into. Never imported by the server --
executor.py substitutes the three markers and runs this file in a subprocess
(rules.md A1). Kept as valid Python so a typo here fails a parse, not a job.
"""
import json
import resource

from playwright.sync_api import sync_playwright


def cap_memory(limit):
    """Bound the generated script's memory. Best effort by design: Darwin
    aliases RLIMIT_AS to RLIMIT_RSS and EINVALs on any finite value, so on a
    mac the wall-clock timeout is the only bound. Linux (production) enforces.
    # ponytail: rlimit only -- poll RSS and kill, or containerize, if a mac
    # ever has to run this for real.
    """
    for name in ("RLIMIT_AS", "RLIMIT_DATA"):
        r = getattr(resource, name, None)
        if r is None:
            continue
        try:
            resource.setrlimit(r, (limit, limit))
            return name
        except (ValueError, OSError):
            continue
    return None


def soften_waits(page):
    """Make `wait_for_load_state` best effort, and cap what it can cost.

    "networkidle" never fires on a page with ad frames, a chat widget or any
    polling, so a script that waits for it loses the whole run to a timeout on
    a page that finished rendering seconds earlier. The model writes it anyway
    -- playwright's own docs discourage it and it is still the first thing an
    LLM reaches for -- and the ~70 scripts already saved in the database
    contain it. Those are replayed by `POST /companies/run`, which never calls
    the model, so nothing would ever repair them.

    The cap matters as much as the swallow: a 30s wait inside a ten-page
    pagination loop is 300s, and the harness kills the run at 120.
    # ponytail: 5s, best effort. It is a settle, not a correctness wait -- the
    # script still has wait_for_selector for anything it actually needs.
    """
    inner = page.wait_for_load_state

    def wait(state=None, timeout=None):
        try:
            inner(state, timeout=min(timeout or 5_000, 5_000))
        except Exception:
            pass                     # the DOM is up; that is what was needed

    page.wait_for_load_state = wait


# --- generated code below ---
# __RUN_FUNCTION__
# --- end generated code ---

if __name__ == "__main__":
    with sync_playwright() as p:
        b = p.chromium.launch(proxy=__PROXY__)
        try:
            page = b.new_page(user_agent=__UA__)
            # Capped after launch on purpose: a child inherits the limit at
            # spawn time, and chromium reserves far more address space than
            # this. So this bounds the generated script, not the browser.
            cap_memory(__MEM__)
            soften_waits(page)
            page.goto(__URL__, wait_until="domcontentloaded", timeout=30_000)
            # Sentinel: playwright and stray print()s share this stdout.
            print("<<<RESULT>>>" + json.dumps(run(page)))
        finally:
            b.close()
